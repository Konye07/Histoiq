*.iml
.gradle
.kotlin
/local.properties
*.jks
*.keystore
# Apple signing material (scripts/ios-signing.mjs writes it outside the repo; this is the safety net).
*.p12
*.p8
*.mobileprovision
IOS_SIGNING_BUNDLE*
.idea
.DS_Store
build/
captures/
.externalNativeBuild
.cxx
.claude/*.lock

# iosApp.xcodeproj is generated from iosApp/project.yml by `xcodegen generate` (CI does this
# itself before building) — project.yml is the source of truth, not the generated project.
iosApp/iosApp.xcodeproj/
iosApp/*.xcworkspace/

# /brag launch-video renders (plus timestamped re-runs) — large generated media, not source.
/brag-output*/

# graphify knowledge-graph output embeds absolute local paths (username, interpreter location).
graphify-out/
__pycache__/

# Per-machine Claude Code settings and other credential-shaped files, so a stray copy can't be committed.
.claude/settings.local.json
.env
.env.*
*.pem
*.key
AuthKey_*
google-services.json
GoogleService-Info.plist
