    <!--
      Google Sign-In (GoogleSignIn SPM package, see GoogleSignInBridge.swift). GIDClientID is the
      iOS-type OAuth client (bundle ID com.konye.historiq); the URL scheme is that same ID reversed
      (REVERSED_CLIENT_ID in Google's downloaded plist). Its ID tokens carry this client as the
      audience, not the Web client the Android build uses, so this ID must also be listed in
      Supabase's Auth > Providers > Google > Client IDs.
    -->
    <key>GIDClientID</key>
    <string>336775147908-46muf5hrup23829srdsdgo9i8upkkt1n.apps.googleusercontent.com</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
