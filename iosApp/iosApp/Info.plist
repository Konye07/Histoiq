            </array>
        </dict>
        <!--
          "Continue with Facebook" (Core/Auth/FacebookSignIn.ios.kt) OAuth-redirect callback —
          scheme/host must match SupabaseClient.kt's install(Auth){scheme;host}, and this same
          deep link must be added to Supabase's Auth > URL Configuration > Redirect URLs allow-list.
        -->
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.konye.historiq</string>
            </array>
        </dict>
    </array>
    <!--
      AdMob (GoogleMobileAds SPM package). GADApplicationIdentifier is the real iOS AdMob app. The
      ad unit IDs are not here: they reach the app through AdsConfig (local.properties), which
      defaults to Google's test units and only ios-release.yml supplies the real ones, so simulator
      and CI builds never serve live ads. SKAdNetworkItems is Google's standard required list for ad
      network attribution (see https://developers.google.com/admob/ios/quick-start), not app-specific.
    -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-1835862082621920~3535758540</string>
